{
  "name": "Game1",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "Villas": {
          "$className": "Folder"
        },
        "Vehicles": {
          "$className": "Folder"
        },
        "Cosmetics": {
          "$className": "Folder"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingMinRadius": 256,
        "StreamingTargetRadius": 1200
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.27, 0.27, 0.31],
        "OutdoorAmbient": [0.55, 0.58, 0.62],
        "Brightness": 3,
        "ClockTime": 14,
        "GeographicLatitude": 12,
        "GlobalShadows": true,
        "Outlines": false,
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.4,
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.25,
          "Haze": 1.6,
          "Glare": 0.1,
          "Color": [0.78, 0.85, 0.92],
          "Decay": [0.42, 0.58, 0.75]
        }
      },
      "TropicalGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.12,
          "Saturation": 0.22,
          "TintColor": [1, 0.99, 0.94]
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
